# ============================================================
# ÉLAN JEWELS - Apache .htaccess for Shared Hosting (cPanel)
# ============================================================

# Disable Directory Browsing
Options -Indexes

# Follow Symbolic Links
Options +FollowSymLinks

# Prevent viewing of sensitive configuration and database files
<FilesMatch "(\.(env|sql|json|lock|git.*|md)|config\.php)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# Allow config.php to be included by PHP, but deny direct web browser HTTP hits
<Files "config.php">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</Files>

# Security Headers
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# PHP Execution Protection inside uploads directory
# (Uploads should never execute PHP scripts)
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Force HTTPS (Uncomment on production cPanel once SSL is active)
    # RewriteCond %{HTTPS} off
    # RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Block direct PHP execution inside uploads folder
    RewriteRule ^uploads/.*\.php$ - [F,L,NC]
</IfModule>
